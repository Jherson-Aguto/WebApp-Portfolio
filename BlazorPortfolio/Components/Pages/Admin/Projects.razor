@page "/admin/projects"
@layout AdminLayout
@rendermode InteractiveServer
@inject ContentService Svc

<PageTitle>Manage Projects</PageTitle>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <h1 style="margin:0;">Labs Projects Registry</h1>
    @if (editing is null)
    {
        <button class="btn-primary" @onclick="AddNew">+ Add Project</button>
    }
</div>

@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="alert-success" style="margin-bottom: 1.5rem;">
        <span class="alert-icon">✅</span>
        <div><strong>@successMsg</strong></div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="alert-error" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 4px; background: rgba(255, 82, 82, 0.1); border: 1px solid #ff5252; color: #ff5252; display: flex; align-items: center; gap: 0.5rem;">
        <span class="alert-icon">⚠️</span>
        <div><strong>@errorMsg</strong></div>
    </div>
}

@if (editing is not null)
{
    <div class="edit-form" style="max-width: 900px; margin-bottom: 2.5rem; border: 1px solid var(--border-cyan); box-shadow: var(--shadow-cyan); padding: 2rem; border-radius: var(--radius); background: var(--surface);">
        <h3 style="margin-top:0; margin-bottom:1.5rem; color:var(--text-bright);">@(editing.Id == 0 ? "New" : "Edit") Labs Project</h3>
        
        <!-- Tabs Navigation -->
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; flex-wrap: wrap;">
            <button type="button" class="btn-sm @(activeTab == "basic" ? "btn-primary" : "btn-secondary")" @onclick='() => SetTab("basic")' style="cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem; border-radius:var(--radius-sm);">
                📁 Basic Info
            </button>
            <button type="button" class="btn-sm @(activeTab == "desc" ? "btn-primary" : "btn-secondary")" @onclick='() => SetTab("desc")' style="cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem; border-radius:var(--radius-sm);">
                📝 Descriptions
            </button>
            <button type="button" class="btn-sm @(activeTab == "tech" ? "btn-primary" : "btn-secondary")" @onclick='() => SetTab("tech")' style="cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem; border-radius:var(--radius-sm);">
                ⚡ Tech &amp; Features
            </button>
            <button type="button" class="btn-sm @(activeTab == "links" ? "btn-primary" : "btn-secondary")" @onclick='() => SetTab("links")' style="cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem; border-radius:var(--radius-sm);">
                🔗 Links &amp; Media
            </button>
            <button type="button" class="btn-sm @(activeTab == "settings" ? "btn-primary" : "btn-secondary")" @onclick='() => SetTab("settings")' style="cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem; border-radius:var(--radius-sm);">
                ⚙️ Settings
            </button>
        </div>

        <EditForm Model="editing" OnValidSubmit="Save">
            <DataAnnotationsValidator />

            @if (activeTab == "basic")
            {
                <div class="tab-content">
                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Title *</label>
                        <InputText @bind-Value="editing.Title" class="form-control" @oninput="OnTitleInput" placeholder="e.g. Meeting Room Backend" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Required. The primary showcase name of the build.</small>
                        <ValidationMessage For="() => editing.Title" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Slug *</label>
                        <InputText @bind-Value="editing.Slug" class="form-control" placeholder="e.g. meeting-room-backend" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Required URL parameter. Generated automatically from Title. Must be lowercase, URL-safe, and unique.</small>
                        <ValidationMessage For="() => editing.Slug" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>

                    <div class="form-row" style="display:flex; gap:1rem; flex-wrap:wrap;">
                        <div class="form-group" style="flex:1; min-width:200px; margin-bottom:1.25rem;">
                            <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Category *</label>
                            <InputSelect @bind-Value="editing.Category" class="form-control" style="width:100%;">
                                <option value="">-- Select Category --</option>
                                <option value="Frontend">Frontend (Static/SPA apps)</option>
                                <option value="Backend">Backend (APIs/Databases/Workers)</option>
                                <option value="Full Stack">Full Stack (Monoliths/Complete apps)</option>
                                <option value="Mobile">Mobile (iOS/Android builds)</option>
                                <option value="Data &amp; AI">Data &amp; AI (ML models/Pipelines)</option>
                                <option value="DevOps">DevOps (Infrastructure/CI-CD)</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                            <ValidationMessage For="() => editing.Category" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                        </div>
                        <div class="form-group" style="flex:1; min-width:200px; margin-bottom:1.25rem;">
                            <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Development Status *</label>
                            <InputSelect @bind-Value="editing.Status" class="form-control" style="width:100%;">
                                <option value="Prototype">Prototype (Initial draft / experimental)</option>
                                <option value="Active">Active (Ongoing development)</option>
                                <option value="Live">Live (Completed &amp; stable)</option>
                                <option value="Archived">Archived (Historical reference)</option>
                            </InputSelect>
                            <ValidationMessage For="() => editing.Status" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "desc")
            {
                <div class="tab-content">
                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Short Description *</label>
                        <InputTextArea @bind-Value="editing.ShortDescription" class="form-control" rows="2" placeholder="Brief 1-2 sentence overview for catalog grids..." style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Required. Displayed on public listing grid cards.</small>
                        <ValidationMessage For="() => editing.ShortDescription" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Detailed Description *</label>
                        <InputTextArea @bind-Value="editing.DetailedDescription" class="form-control" rows="6" placeholder="Provide a detailed explanation of the project, architecture, development processes, and results..." style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Required. Renders as the primary body copy of the project detail page.</small>
                        <ValidationMessage For="() => editing.DetailedDescription" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Problem Statement (Optional)</label>
                        <InputTextArea @bind-Value="editing.ProblemStatement" class="form-control" rows="3" placeholder="Describe the challenge or limitation this project aims to solve..." style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Optional. Explains the core difficulty or issue to help outline user intent.</small>
                    </div>

                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Solution Overview (Optional)</label>
                        <InputTextArea @bind-Value="editing.SolutionOverview" class="form-control" rows="3" placeholder="Describe how your implementation solves the problem..." style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Optional. Explains your architecture decisions and design patterns.</small>
                    </div>
                </div>
            }

            @if (activeTab == "tech")
            {
                <div class="tab-content">
                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Technology Stack (Comma-separated)</label>
                        <InputText @bind-Value="editing.TechStack" class="form-control" placeholder="e.g. ASP.NET Core, PostgreSQL, Blazor, Redis" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Separate technologies with commas. Will be converted to dynamic badge arrays.</small>
                    </div>

                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Key Features (One feature per line)</label>
                        <InputTextArea @bind-Value="editing.KeyFeatures" class="form-control" rows="5" placeholder="e.g.&#10;Dynamic caching middleware&#10;Dual-token authorization scheme&#10;Real-time dashboard updates" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Enter each feature on a separate line. Serialized to an array for detailed layouts.</small>
                    </div>
                </div>
            }

            @if (activeTab == "links")
            {
                <div class="tab-content">
                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Image Banner URL (Optional)</label>
                        <InputText @bind-Value="editing.ImageUrl" class="form-control" placeholder="https://i.imgur.com/example.png or /assets/banners/project.png" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">URL path for the preview image of this project card.</small>
                        <ValidationMessage For="() => editing.ImageUrl" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Live Production URL (Optional)</label>
                        <InputText @bind-Value="editing.LiveUrl" class="form-control" placeholder="https://app.jhersonaguto.dev" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Direct URL link to the deployed active application.</small>
                        <ValidationMessage For="() => editing.LiveUrl" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Source Code GitHub URL (Optional)</label>
                        <InputText @bind-Value="editing.RepositoryUrl" class="form-control" placeholder="https://github.com/Jherson-Aguto/app-name" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Direct repository URL for code reviews.</small>
                        <ValidationMessage For="() => editing.RepositoryUrl" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Interactive Demo URL (Optional)</label>
                        <InputText @bind-Value="editing.DemoUrl" class="form-control" placeholder="https://demo.jhersonaguto.dev" style="width:100%;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Demo walkthrough video link or staging testbed link.</small>
                        <ValidationMessage For="() => editing.DemoUrl" style="color:#ff5252; font-size:0.85rem; display:block; margin-top:0.25rem;" />
                    </div>
                </div>
            }

            @if (activeTab == "settings")
            {
                <div class="tab-content">
                    <div class="form-group" style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem;">
                        <InputCheckbox @bind-Value="editing.IsPublished" id="chkPublished" style="width:18px; height:18px; cursor:pointer;" />
                        <label for="chkPublished" style="margin:0; font-weight:normal; cursor:pointer; color:var(--text);">Publish Project (Make visible publicly on Labs Workspace)</label>
                    </div>

                    <div class="form-group" style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1.25rem;">
                        <InputCheckbox @bind-Value="editing.Featured" id="chkFeatured" style="width:18px; height:18px; cursor:pointer;" />
                        <label for="chkFeatured" style="margin:0; font-weight:normal; cursor:pointer; color:var(--text);">Featured build (Highlight/pin to top sections)</label>
                    </div>

                    <div class="form-group" style="margin-bottom: 1.25rem;">
                        <label style="display:block; margin-bottom:0.4rem; font-weight:600; color:var(--text-bright);">Display Sort Order</label>
                        <InputNumber @bind-Value="editing.SortOrder" class="form-control" style="max-width:150px;" />
                        <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Lower values rank higher in display precedence.</small>
                    </div>
                </div>
            }

            <div style="margin-top: 2rem; display: flex; gap: 0.5rem;">
                <button type="submit" class="btn-primary" style="cursor:pointer;">Save Project</button>
                <button type="button" class="btn-secondary" @onclick="Cancel" style="cursor:pointer;">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@if (editing is null)
{
    <style>
        .projects-table-container {
            margin-top: 1rem;
        }
        
        .admin-table th, .admin-table td {
            vertical-align: middle;
            padding: 0.9rem 1rem;
        }

        .col-title {
            min-width: 220px;
        }

        .col-category {
            width: 140px;
        }

        .col-status {
            width: 140px;
        }

        .col-featured, .col-published, .col-order {
            width: 90px;
            text-align: center;
        }

        .col-updated {
            width: 130px;
        }

        .col-actions {
            width: 150px;
            white-space: nowrap;
            text-align: right;
        }

        .status-text-truncate {
            max-width: 120px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: inline-block;
        }

        .admin-table tbody tr {
            transition: background-color 0.15s ease;
        }
    </style>

    <div class="admin-table-wrap projects-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="col-title">Title</th>
                    <th class="col-category">Category</th>
                    <th class="col-status">Status</th>
                    <th class="col-featured" style="text-align:center">Featured</th>
                    <th class="col-published" style="text-align:center">Published</th>
                    <th class="col-order" style="text-align:center">Order</th>
                    <th class="col-updated">Last Updated</th>
                    <th class="col-actions" style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="text-align:center; padding: 3rem; color: var(--text-muted);">
                            No project registry entries exist. Click "+ Add Project" to insert a showcase build.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var proj in items)
                    {
                        <tr>
                            <td class="col-title">
                                <strong style="color:var(--text-bright)">@proj.Title</strong>
                                <br />
                                <small style="color:var(--text-muted); font-family:monospace; font-size:0.75rem;">@proj.Slug</small>
                            </td>
                            <td class="col-category">
                                <span class="badge" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; color: var(--text);">
                                    @proj.Category
                                </span>
                            </td>
                            <td class="col-status">
                                @if (proj.Status == "Live")
                                {
                                    <span style="color:#00e5ff; font-weight:bold; display:inline-flex; align-items:center; gap:0.35rem; font-size:0.9rem;">
                                        <span style="display:inline-block; width:6px; height:6px; background-color:#00e5ff; border-radius:50%; box-shadow:0 0 6px #00e5ff;"></span>
                                        Live
                                    </span>
                                }
                                else if (proj.Status == "Active")
                                {
                                    <span style="color:#ffb300; font-weight:bold; display:inline-flex; align-items:center; gap:0.35rem; font-size:0.9rem;">
                                        <span style="display:inline-block; width:6px; height:6px; background-color:#ffb300; border-radius:50%; box-shadow:0 0 6px #ffb300;"></span>
                                        Active
                                    </span>
                                }
                                else if (proj.Status == "Prototype")
                                {
                                    <span style="color:#a29bfe; font-weight:bold; display:inline-flex; align-items:center; gap:0.35rem; font-size:0.9rem;">
                                        <span style="display:inline-block; width:6px; height:6px; background-color:#a29bfe; border-radius:50%; box-shadow:0 0 6px #a29bfe;"></span>
                                        Prototype
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted); display:inline-flex; align-items:center; gap:0.35rem; font-size:0.9rem;" title="@proj.Status">
                                        <span style="display:inline-block; width:6px; height:6px; background-color:var(--text-muted); border-radius:50%;"></span>
                                        <span class="status-text-truncate">@proj.Status</span>
                                    </span>
                                }
                            </td>
                            <td class="col-featured" style="text-align:center">
                                @if (proj.Featured)
                                {
                                    <span style="color:#ffd166; font-size:1.2rem;" title="Featured">★</span>
                                }
                                else
                                {
                                    <span style="color:var(--border); font-size:1.2rem;">☆</span>
                                }
                            </td>
                            <td class="col-published" style="text-align:center">
                                @if (proj.IsPublished)
                                {
                                    <span style="background:rgba(0, 229, 255, 0.08); border:1px solid #00e5ff; color:#00e5ff; padding:0.2rem 0.5rem; border-radius:4px; font-size:0.75rem; font-weight:bold;">
                                        Published
                                    </span>
                                }
                                else
                                {
                                    <span style="background:rgba(255,255,255,0.02); border:1px solid var(--border); color:var(--text-muted); padding:0.2rem 0.5rem; border-radius:4px; font-size:0.75rem;">
                                        Draft
                                    </span>
                                }
                            </td>
                            <td class="col-order" style="text-align:center; font-family:monospace;">
                                @proj.SortOrder
                            </td>
                            <td class="col-updated">
                                <span style="font-size:0.85rem;" title="@proj.UpdatedAt.ToString("g")">
                                    @FormatDate(proj.UpdatedAt)
                                </span>
                            </td>
                            <td class="col-actions" style="text-align:right">
                                <button class="btn-sm" @onclick="() => Edit(proj)" style="cursor:pointer; margin-right:0.2rem;">Edit</button>
                                <button class="btn-sm danger" @onclick="() => Delete(proj.Id)" style="cursor:pointer;">Delete</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    List<Project> items = [];
    Project? editing;
    string activeTab = "basic";
    string? successMsg;
    string? errorMsg;
    bool isNewProject = false;

    protected override async Task OnInitializedAsync() => await Load();
    async Task Load() => items = await Svc.GetProjectsAsync();

    void SetTab(string tab) => activeTab = tab;

    void AddNew()
    {
        successMsg = null;
        errorMsg = null;
        editing = new();
        isNewProject = true;
        activeTab = "basic";
    }

    void Edit(Project p)
    {
        successMsg = null;
        errorMsg = null;
        editing = new Project
        {
            Id = p.Id,
            Title = p.Title,
            Slug = p.Slug,
            ShortDescription = p.ShortDescription,
            DetailedDescription = p.DetailedDescription,
            ProblemStatement = p.ProblemStatement,
            SolutionOverview = p.SolutionOverview,
            KeyFeatures = p.KeyFeatures,
            TechStack = p.TechStack,
            Category = p.Category,
            Status = p.Status,
            ImageUrl = p.ImageUrl,
            LiveUrl = p.LiveUrl,
            RepositoryUrl = p.RepositoryUrl,
            DemoUrl = p.DemoUrl,
            Featured = p.Featured,
            IsPublished = p.IsPublished,
            SortOrder = p.SortOrder,
            PublishedAt = p.PublishedAt,
            UpdatedAt = p.UpdatedAt
        };
        isNewProject = false;
        activeTab = "basic";
    }

    void Cancel()
    {
        editing = null;
        isNewProject = false;
    }

    void OnTitleInput(ChangeEventArgs e)
    {
        if (isNewProject)
        {
            var title = e.Value?.ToString() ?? "";
            editing!.Slug = GenerateSlug(title);
        }
    }

    string GenerateSlug(string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return "";
        var slug = title.ToLowerInvariant();
        // Remove accents and invalid characters
        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"[^a-z0-9\s-]", "");
        // Replace spaces/hyphens with a single hyphen
        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"[\s-]+", "-").Trim('-');
        return slug;
    }

    async Task Save()
    {
        successMsg = null;
        errorMsg = null;

        // Validations
        if (string.IsNullOrWhiteSpace(editing!.Title))
        {
            errorMsg = "Title is required.";
            return;
        }

        editing.Slug = GenerateSlug(editing.Slug);
        if (string.IsNullOrWhiteSpace(editing.Slug))
        {
            errorMsg = "Slug is required and must be URL-safe.";
            return;
        }

        // Verify slug uniqueness
        var isUnique = await Svc.IsSlugUniqueAsync(editing.Slug, editing.Id);
        if (!isUnique)
        {
            errorMsg = "A project with this slug already exists. Slugs must be globally unique.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editing.ShortDescription))
        {
            errorMsg = "Short Description is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editing.DetailedDescription))
        {
            errorMsg = "Detailed Description is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editing.Category))
        {
            errorMsg = "Category is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editing.Status))
        {
            errorMsg = "Status is required.";
            return;
        }

        // URL format checks if provided
        if (!IsValidUrl(editing.ImageUrl)) { errorMsg = "Image URL is not a valid absolute or relative URL."; return; }
        if (!IsValidUrl(editing.LiveUrl)) { errorMsg = "Live URL is not a valid URL."; return; }
        if (!IsValidUrl(editing.RepositoryUrl)) { errorMsg = "Repository URL is not a valid URL."; return; }
        if (!IsValidUrl(editing.DemoUrl)) { errorMsg = "Demo URL is not a valid URL."; return; }

        try
        {
            await Svc.SaveProjectAsync(editing);
            successMsg = $"Project '{editing.Title}' saved successfully.";
            editing = null;
            await Load();
        }
        catch (Exception ex)
        {
            errorMsg = $"Failed to save project metadata: {ex.Message}";
        }
    }

    async Task Delete(int id)
    {
        successMsg = null;
        errorMsg = null;

        try
        {
            await Svc.DeleteProjectAsync(id);
            successMsg = "Project deleted successfully from the registry.";
            await Load();
        }
        catch (Exception ex)
        {
            errorMsg = $"Failed to delete project: {ex.Message}";
        }
    }

    bool IsValidUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return true; // optional fields
        var s = url.Trim();
        if (s.StartsWith("/") || s.StartsWith("./")) return true; // allow site root/relative paths
        return Uri.TryCreate(s, UriKind.Absolute, out var uriResult) 
               && (uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps);
    }

    string FormatDate(DateTime dt)
    {
        var d = DateTime.UtcNow - dt;
        if (d.TotalMinutes < 1) return "just now";
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalDays < 1) return $"{(int)d.TotalHours}h ago";
        if (d.TotalDays < 30) return $"{(int)d.TotalDays}d ago";
        return dt.ToString("MMM dd, yyyy");
    }
}
