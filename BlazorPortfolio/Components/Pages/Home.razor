@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject ContentService Svc
@inject CacheService Cache
@inject GitHubService GitHub
@inject Services.EmailService Email
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>@(string.IsNullOrEmpty(profile?.OwnerName) ? "Jherson Aguto | Full Stack Developer Portfolio" : $"{profile.OwnerName} | Full Stack Developer Portfolio")</PageTitle>
<HeadContent>
    <meta property="og:title" content="@(profile?.OwnerName ?? "Jherson Aguto") | Full Stack Developer Portfolio" />
    <meta property="og:description" content="@(profile?.Tagline ?? "Full Stack Developer specializing in .NET, Blazor, and Backend Systems.")" />
    @if (!string.IsNullOrEmpty(profile?.AvatarUrl))
    {
        <meta property="og:image" content="@profile.AvatarUrl" />
        <meta name="twitter:image" content="@profile.AvatarUrl" />
    }
    <meta name="twitter:title" content="@(profile?.OwnerName ?? "Jherson Aguto") | Full Stack Developer Portfolio" />
    <meta name="twitter:description" content="@(profile?.Tagline ?? "Full Stack Developer specializing in .NET, Blazor, and Backend Systems.")" />
    @{
        var socialLinks = new List<string>();
        if (!string.IsNullOrEmpty(profile?.GitHubUrl)) socialLinks.Add(profile.GitHubUrl);
        if (!string.IsNullOrEmpty(profile?.LinkedInUrl)) socialLinks.Add(profile.LinkedInUrl);
        var socialJson = string.Join(",", socialLinks.Select(l => $"\"{l}\""));
    }
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Person",
      "name": "Jherson Aguto",
      "url": "https://jhersonaguto.dev/",
      "jobTitle": "Full Stack Developer",
      "description": "Computer Science Student and Software Developer focused on ASP.NET Core, Blazor, and Backend Systems.",
      "knowsAbout": ["ASP.NET Core", "Blazor", "C#", "Entity Framework Core", "PostgreSQL", "Backend Development", "Full-Stack Web Development"],
      "sameAs": [@((MarkupString)socialJson)]
    }
    </script>
</HeadContent>

<!-- HERO -->
<section class="hero" id="about">
    <div class="hero-bg"><div class="hero-grid-lines"></div></div>
    <div class="container hero-content">
        <div class="hero-text">
            <p class="hero-eyebrow">@(profile?.Eyebrow ?? "Welcome to my portfolio")</p>
            <h1>Hi, I'm <span class="hero-name">@(profile?.OwnerName ?? "Your Name")</span></h1>
            <p class="tagline">@(profile?.Tagline ?? "Full Stack Developer · .NET · Blazor · Cloud")</p>
            <p class="hero-bio">@(profile?.HeroBio ?? "")</p>
            <div class="hero-actions">
                <a href="#contact" class="btn-primary">@(profile?.HeroCta ?? "Hire Me")</a>
                <a href="#projects" class="btn-outline">@(profile?.HeroSecondaryCta ?? "See My Work")</a>
                <a href="https://resume.jhersonaguto.dev/" target="_blank" rel="noopener noreferrer" class="btn-outline btn-resume">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3.75 1.5a.25.25 0 0 0-.25.25v11.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25V6H9.75A1.75 1.75 0 0 1 8 4.25V1.5H3.75Zm5.75.56v2.19c0 .138.112.25.25.25h2.19L9.5 2.06ZM2 1.75C2 .784 2.784 0 3.75 0h5.086c.464 0 .909.184 1.237.513l3.414 3.414c.329.328.513.773.513 1.237v8.086A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 13.25V1.75Z"/></svg>
                    Resume
                </a>
            </div>
        </div>
        <div class="hero-avatar">
            <div class="avatar-ring">
                @{
                    var avatarSrc = !string.IsNullOrEmpty(ghProfile?.AvatarUrl)
                        ? ghProfile!.AvatarUrl
                        : (!string.IsNullOrEmpty(profile?.AvatarUrl) && !profile.AvatarUrl.StartsWith("/uploads/"))
                            ? profile.AvatarUrl
                            : null;
                }
                @if (!string.IsNullOrEmpty(avatarSrc))
                {
                    <img class="avatar-img" src="@avatarSrc" alt="@profile?.OwnerName" loading="eager" decoding="async" fetchpriority="high" />
                }
                else
                {
                    <div class="avatar-inner">@GetInitials(profile?.OwnerName)</div>
                }
            </div>
        </div>
    </div>
    <a href="#experience" class="scroll-hint" aria-label="Scroll down">
        <span class="scroll-arrow"></span>
    </a>
</section>

<!-- EXPERIENCE -->
<section class="section" id="experience">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Career</span>
            <h2>Experience</h2>
        </div>
        @if (experiences is null)
        {
            <div class="skeleton-list"><div class="skeleton"></div><div class="skeleton"></div></div>
        }
        else
        {
            <div class="timeline">
                @foreach (var exp in experiences)
                {
                    <div class="timeline-item anim-slide">
                        <div class="timeline-dot"></div>
                        <div class="timeline-card">
                            <div class="timeline-meta"><span class="tl-period">@exp.Period</span></div>
                            <h3>@exp.Title</h3>
                            <p class="tl-company">@exp.Company</p>
                            <p class="tl-desc">@exp.Description</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- PROJECTS -->
<section class="section alt" id="projects">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Portfolio Migration</span>
            <h2>Active Projects & Builds</h2>
        </div>
        
        <div class="project-portal-card anim-scale" style="background: linear-gradient(135deg, rgba(10, 14, 20, 0.7) 0%, rgba(16, 23, 33, 0.9) 100%); border: 1px solid var(--border-cyan); border-radius: var(--radius); padding: 3rem 2rem; box-shadow: var(--shadow-cyan); text-align: center; max-width: 900px; margin: 0 auto; position: relative; overflow: hidden; backdrop-filter: blur(8px);">
            <!-- Subtle background glows -->
            <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: radial-gradient(circle, rgba(0, 229, 255, 0.15) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>
            <div style="position: absolute; bottom: -50px; left: -50px; width: 180px; height: 180px; background: radial-gradient(circle, rgba(124, 111, 255, 0.1) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>

            <!-- Portal Status Badge -->
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--cyan-glow2); border: 1px solid var(--border-cyan); border-radius: 30px; padding: 0.4rem 1rem; margin-bottom: 1.5rem; font-size: 0.8rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em; text-transform: uppercase;">
                <span style="display: inline-block; width: 6px; height: 6px; background-color: var(--cyan); border-radius: 50%; box-shadow: 0 0 8px var(--cyan);"></span>
                Centralized Project Registry Active
            </div>

            <h3 style="font-size: 2rem; font-weight: 800; color: var(--text-bright); margin: 0 0 1rem 0; letter-spacing: -0.03em; line-height: 1.2;">
                My Projects Have Moved to <span style="color: var(--cyan); text-shadow: 0 0 15px rgba(0, 229, 255, 0.3);">labs.jhersonaguto.dev</span>
            </h3>

            <p style="color: var(--text); font-size: 1.05rem; line-height: 1.8; max-width: 680px; margin: 0 auto 2.5rem auto;">
                To demonstrate a modern API-driven architecture, all my live projects, background microservices, and experiments are hosted dynamically inside my experimental workspace subdomain.
            </p>

            <!-- Workspace Features Preview Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; max-width: 760px; margin: 0 auto 2.5rem auto; text-align: left;">
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 8px; padding: 1.25rem; transition: border-color var(--transition);">
                    <div style="font-size: 1.25rem; margin-bottom: 0.5rem;">⚙️</div>
                    <h4 style="color: var(--text-bright); margin: 0 0 0.25rem 0; font-size: 0.95rem;">API-First Catalog</h4>
                    <p style="color: var(--text-muted); font-size: 0.82rem; margin: 0; line-height: 1.4;">Project details are fetched in real-time from a Go Fiber REST API.</p>
                </div>
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 8px; padding: 1.25rem; transition: border-color var(--transition);">
                    <div style="font-size: 1.25rem; margin-bottom: 0.5rem;">⚡</div>
                    <h4 style="color: var(--text-bright); margin: 0 0 0.25rem 0; font-size: 0.95rem;">Live Playgrounds</h4>
                    <p style="color: var(--text-muted); font-size: 0.82rem; margin: 0; line-height: 1.4;">Launch, test, and interact with live experiments immediately.</p>
                </div>
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 8px; padding: 1.25rem; transition: border-color var(--transition);">
                    <div style="font-size: 1.25rem; margin-bottom: 0.5rem;">📂</div>
                    <h4 style="color: var(--text-bright); margin: 0 0 0.25rem 0; font-size: 0.95rem;">Architectural Specs</h4>
                    <p style="color: var(--text-muted); font-size: 0.82rem; margin: 0; line-height: 1.4;">Every project showcases its tech stack, live URLs, and GitHub repos.</p>
                </div>
            </div>

            <!-- CTA Actions -->
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="https://labs.jhersonaguto.dev" target="_blank" rel="noopener noreferrer" class="btn-primary" style="text-decoration: none; padding: 0.9rem 2.2rem; font-size: 1rem; display: inline-flex; align-items: center; gap: 0.6rem; box-shadow: 0 8px 20px var(--cyan-glow);">
                    Explore My Labs Workspace
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition: transform var(--transition);">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- STAR MAP -->
@if (constellations.Count > 0)
{
    <section class="section" id="skills">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">What I Know</span>
                <h2>Tech Stack</h2>
                <p>A celestial map of my skills — larger stars mean higher proficiency.</p>
            </div>
            <div class="constellation-legend">
                @foreach (var sys in constellations)
                {
                    var s = sys;
                    <span class="cl-item @(activeSystem == s.Name ? "cl-active" : "")"
                          style="@(activeSystem == s.Name ? $"border-color:{s.Color};color:{s.Color}" : "")"
                          @onclick="() => { SetSystem(s.Name); }">
                        <span class="cl-dot" style="background:@s.Color"></span>
                        @s.Name
                    </span>
                }
            </div>
            @{
                var active = constellations.FirstOrDefault(c => c.Name == activeSystem) ?? constellations[0];
            }
            <div class="starmap-wrap">
                <canvas id="starmap-canvas"
                        data-systems="@System.Text.Json.JsonSerializer.Serialize(constellations.Select(c => new { c.Name, c.Color, c.Nodes, c.Edges }))"
                        data-active="@active.Name">
                </canvas>
                <div id="starmap-tooltip" class="starmap-tooltip" style="display:none"></div>
            </div>
        </div>
    </section>
}

<!-- GITHUB -->
@if (!string.IsNullOrWhiteSpace(profile?.GitHubUsername))
{
    <ErrorBoundary>
        <ChildContent>
    <section class="section alt" id="github">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Open Source</span>
                <h2>GitHub</h2>
            </div>

            @if (ghProfile is not null)
            {
                <div class="gh-banner anim-slide">
                    @if (!string.IsNullOrEmpty(ghProfile.AvatarUrl))
                    {
                        <img src="@ghProfile.AvatarUrl" alt="@ghProfile.Name" class="gh-banner-avatar" loading="lazy" decoding="async" />
                    }
                    <div class="gh-banner-info">
                        <div class="gh-banner-name">@ghProfile.Name</div>
                        @if (!string.IsNullOrEmpty(ghProfile.Bio))
                        {
                            <div class="gh-banner-bio">@ghProfile.Bio</div>
                        }
                        <div class="gh-banner-stats">
                            <span class="gh-stat-chip">
                                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8Z"/></svg>
                                @ghProfile.PublicRepos public repos
                            </span>
                            <span class="gh-stat-chip">
                                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M2 5.5a3.5 3.5 0 1 1 5.898 2.549 5.508 5.508 0 0 1 3.034 4.084.75.75 0 1 1-1.482.235 4 4 0 0 0-7.9 0 .75.75 0 0 1-1.482-.236A5.507 5.507 0 0 1 3.102 8.05 3.493 3.493 0 0 1 2 5.5ZM11 4a3.001 3.001 0 0 1 2.22 5.018 5.01 5.01 0 0 1 2.56 3.012.749.749 0 0 1-.885.954.752.752 0 0 1-.549-.514 3.507 3.507 0 0 0-2.522-2.372.75.75 0 0 1-.574-.73v-.352a.75.75 0 0 1 .416-.672A1.5 1.5 0 0 0 11 5.5.75.75 0 0 1 11 4Zm-5.5-.5a2 2 0 1 0-.001 3.999A2 2 0 0 0 5.5 3.5Z"/></svg>
                                @ghProfile.Followers followers
                            </span>
                            @if (ghContribTotal > 0)
                            {
                                <span class="gh-stat-chip highlight">
                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"/></svg>
                                    @ghContribTotal contributions this year
                                </span>
                            }
                        </div>
                    </div>
                    <div class="gh-banner-actions">
                        <a href="@("https://github.com/" + profile!.GitHubUsername)" target="_blank" rel="noopener noreferrer" class="gh-view-profile">
                            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                            View on GitHub
                        </a>
                    </div>
                </div>
            }

            <div class="gh-tabs">
                <button class="gh-tab @(repoTab == "pinned" ? "active" : "")" @onclick='() => SetTab("pinned")'>
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                    Pinned
                </button>
                <button class="gh-tab @(repoTab == "all" ? "active" : "")" @onclick='() => SetTab("all")'>
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8Z"/></svg>
                    All Public Repos
                    @if (allRepos is not null) { <span class="gh-tab-count">@allRepos.Count</span> }
                </button>
            </div>

            @{
                var displayRepos = repoTab == "all" ? allRepos : pinnedRepos;
                var isLoading    = repoTab == "all" ? allRepos is null : pinnedRepos is null;
            }
            @if (isLoading)
            {
                <div class="gh-repos-skeleton">
                    @for (int i = 0; i < 6; i++) { <div class="skeleton gh-repo-skeleton"></div> }
                </div>
            }
            else if (displayRepos is { Count: 0 })
            {
                <div class="gh-empty-state">
                    <svg width="32" height="32" viewBox="0 0 16 16" fill="currentColor" style="color:var(--text-muted)"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8Z"/></svg>
                    <p>No public repositories found for <strong>@profile!.GitHubUsername</strong>.</p>
                    <a href="@("https://github.com/" + profile!.GitHubUsername)" target="_blank" rel="noopener noreferrer" class="gh-view-profile" style="margin-top:.5rem">View on GitHub ↗</a>
                </div>
            }
            else if (displayRepos is not null)
            {
                <div class="gh-repos-grid">
                    @{ int ci = 0; }
                    @foreach (var repo in displayRepos)
                    {
                        var cd = $"d{(ci % 6) + 1}"; ci++;
                        <div class="gh-repo-card anim-scale @cd">
                            <div class="gh-repo-header">
                                <div class="gh-repo-name-row">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="gh-repo-icon"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8Z"/></svg>
                                    <a href="@repo.Url" target="_blank" class="gh-repo-title">@repo.Name</a>
                                </div>
                                <div class="gh-repo-actions">
                                    @if (!string.IsNullOrEmpty(repo.HomepageUrl))
                                    {
                                        <a href="@repo.HomepageUrl" target="_blank" rel="noopener noreferrer" class="gh-icon-btn" title="Live demo">
                                            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M3.75 2h3.5a.75.75 0 0 1 0 1.5h-3.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25v-3.5a.75.75 0 0 1 1.5 0v3.5A1.75 1.75 0 0 1 12.25 14h-8.5A1.75 1.75 0 0 1 2 12.25v-8.5C2 2.784 2.784 2 3.75 2Zm6.854-1h4.146a.25.25 0 0 1 .25.25v4.146a.25.25 0 0 1-.427.177L13.03 4.03 9.28 7.78a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l3.75-3.75-1.543-1.543A.25.25 0 0 1 10.604 1Z"/></svg>
                                        </a>
                                    }
                                    <a href="@repo.Url" target="_blank" rel="noopener noreferrer" class="gh-icon-btn" title="View on GitHub">
                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                                    </a>
                                </div>
                            </div>
                            <p class="gh-repo-desc">@(string.IsNullOrEmpty(repo.Description) ? "No description." : repo.Description)</p>
                            @if (repo.Topics.Count > 0)
                            {
                                <div class="gh-topics">
                                    @foreach (var topic in repo.Topics.Take(4))
                                    {
                                        <span class="gh-topic">@topic</span>
                                    }
                                </div>
                            }
                            <div class="gh-repo-footer">
                                @if (!string.IsNullOrEmpty(repo.PrimaryLanguage))
                                {
                                    <span class="gh-lang">
                                        <span class="gh-lang-dot" style="background:@repo.LanguageColor"></span>
                                        @repo.PrimaryLanguage
                                    </span>
                                }
                                @if (repo.Stars > 0)
                                {
                                    <span class="gh-meta-item">
                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                                        @repo.Stars
                                    </span>
                                }
                                @if (repo.Forks > 0)
                                {
                                    <span class="gh-meta-item">
                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
                                        @repo.Forks
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(repo.UpdatedAt) && DateTime.TryParse(repo.UpdatedAt, out var updAt))
                                {
                                    <span class="gh-meta-item gh-updated">@TimeAgo(updAt)</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (ghContribWeeks is { Count: > 0 })
            {
                <div class="gh-contrib-wrap">
                    <div class="gh-contrib-top">
                        <div>
                            <div class="gh-contrib-title">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"/></svg>
                                @ghContribTotal contributions in the last year
                            </div>
                            <div class="gh-contrib-sub">Coding activity across all public repositories</div>
                        </div>
                        <div class="gh-streaks">
                            @if (longestStreak > 0)
                            {
                                <div class="gh-streak">
                                    <span class="gh-streak-val">@longestStreak</span>
                                    <span class="gh-streak-label">🔥 Longest streak</span>
                                </div>
                            }
                            @if (currentStreak > 0)
                            {
                                <div class="gh-streak">
                                    <span class="gh-streak-val">@currentStreak</span>
                                    <span class="gh-streak-label">⚡ Current streak</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="gh-graph-scroll">
                        <div class="gh-graph-inner">
                            <div class="gh-months" style="--week-count:@ghContribWeeks.Count">
                                @foreach (var (label, col) in monthLabels)
                                {
                                    <span class="gh-month-lbl" style="grid-column:@col">@label</span>
                                }
                            </div>
                            <div class="gh-graph-body">
                                <div class="gh-day-lbls">
                                    <span></span><span>Mon</span><span></span>
                                    <span>Wed</span><span></span><span>Fri</span><span></span>
                                </div>
                                <div class="gh-weeks">
                                    @foreach (var week in ghContribWeeks)
                                    {
                                        <div class="gh-week">
                                            @for (int d = 0; d < 7; d++)
                                            {
                                                var day = week.Days.FirstOrDefault(x => x.DayOfWeek == d);
                                                if (day is not null)
                                                {
                                                    <span class="gh-cell @(day.Count > 0 ? "has-contrib" : "gh-cell-zero")"
                                                          style="background:@day.Color"
                                                          title="@day.Date — @day.Count contribution@(day.Count == 1 ? "" : "s")"></span>
                                                }
                                                else
                                                {
                                                    <span class="gh-cell gh-cell-empty"></span>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="gh-legend">
                        <span>Less</span>
                        <span class="gh-cell" style="background:rgba(255,255,255,.04)"></span>
                        <span class="gh-cell" style="background:#0e4429"></span>
                        <span class="gh-cell" style="background:#006d32"></span>
                        <span class="gh-cell" style="background:#26a641"></span>
                        <span class="gh-cell" style="background:#39d353"></span>
                        <span>More</span>
                    </div>
                </div>
            }
        </div>
    </section>
        </ChildContent>
        <ErrorContent>
            <section class="section alt" id="github">
                <div class="container">
                    <div class="section-header">
                        <span class="section-tag">Open Source</span>
                        <h2>GitHub</h2>
                    </div>
                    <div class="gh-empty-state">
                        <svg width="32" height="32" viewBox="0 0 16 16" fill="currentColor" style="color:var(--text-muted)"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                        <p>GitHub data is temporarily unavailable. <a href="https://github.com/@profile!.GitHubUsername" target="_blank" rel="noopener noreferrer">View on GitHub ↗</a></p>
                    </div>
                </div>
            </section>
        </ErrorContent>
    </ErrorBoundary>
}

<!-- CONTACT -->
<section class="section" id="contact">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Contact</span>
            <h2>Get In Touch</h2>
            <p>Looking to collaborate or just want to say hi? Feel free to reach out.</p>
        </div>
        <div class="contact-layout">
            <div class="contact-info">
                <div class="contact-card">
                    <h3>Contact Info</h3>
                    <ul class="contact-details">
                        @if (!string.IsNullOrEmpty(profile?.Email))
                        {
                            <li><span class="ci-icon"><Icon Name="mail" Size="18" /></span> <a href="mailto:@profile.Email">@profile.Email</a></li>
                        }
                        @if (!string.IsNullOrEmpty(profile?.Location))
                        {
                            <li><span class="ci-icon"><Icon Name="map-pin" Size="18" /></span> @profile.Location</li>
                        }
                    </ul>
                    <div class="social-links-footer">
                        @if (!string.IsNullOrEmpty(profile?.GitHubUrl))
                        {
                            <a href="@profile.GitHubUrl" target="_blank" rel="noopener noreferrer" class="social-icon-btn"><Icon Name="github" Size="20" /></a>
                        }
                        @if (!string.IsNullOrEmpty(profile?.LinkedInUrl))
                        {
                            <a href="@profile.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="social-icon-btn"><Icon Name="linkedin" Size="20" /></a>
                        }
                    </div>
                </div>
            </div>
            
            <div class="contact-form-wrapper">
                <div class="contact-card" style="text-align: left; padding: 2rem;">
                    <h3 style="margin-bottom: 1.5rem; text-align: center;">Send a Message</h3>
                    @if (contactSent)
                    {
                        <div class="alert-success" style="text-align: center; padding: 2rem 1rem;">
                            <span class="alert-icon" style="display: block; margin-bottom: 1rem;"><Icon Name="check-circle" Size="36" /></span>
                            <strong style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem;">Message Sent!</strong>
                            <p style="font-size: 0.9rem; color: var(--text-muted); margin: 0;">Thanks for reaching out. I'll get back to you soon.</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="contactModel" OnValidSubmit="SendContactMessage">
                            <DataAnnotationsValidator />
                            <div class="form-group" style="margin-bottom: 1rem;">
                                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.85rem;">Name *</label>
                                <InputText @bind-Value="contactModel.Name" class="form-control" placeholder="Your Name" />
                                <ValidationMessage For="() => contactModel.Name" class="validation-message" />
                            </div>
                            <div class="form-group" style="margin-bottom: 1rem;">
                                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.85rem;">Email *</label>
                                <InputText @bind-Value="contactModel.Email" class="form-control" placeholder="your@email.com" />
                                <ValidationMessage For="() => contactModel.Email" class="validation-message" />
                            </div>
                            <div class="form-group" style="margin-bottom: 1rem;">
                                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.85rem;">Message *</label>
                                <InputTextArea @bind-Value="contactModel.Message" class="form-control" rows="4" placeholder="How can we work together?" />
                                <ValidationMessage For="() => contactModel.Message" class="validation-message" />
                            </div>
                            <InputText @bind-Value="contactHoneypot" class="hp-field" autocomplete="off" tabindex="-1" style="display:none;" />
                            <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 0.5rem;" disabled="@isSendingContact">
                                @(isSendingContact ? "Sending..." : "Send Message →")
                            </button>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="site-footer">
    <div class="container footer-inner">
        <span>Designed &amp; Built by <span class="accent">@(profile?.OwnerName ?? "Your Name")</span></span>
        <span class="footer-stack">Blazor · EF Core · PostgreSQL</span>
    </div>
</footer>

@code {
    private class ContactMessageModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Message is required")]
        public string Message { get; set; } = "";
    }

    ContactMessageModel contactModel = new();
    bool isSendingContact = false;
    bool contactSent = false;
    string contactHoneypot = "";

    async Task SendContactMessage()
    {
        if (!string.IsNullOrEmpty(contactHoneypot)) return; // Bot trapped
        if (isSendingContact) return;

        isSendingContact = true;
        try
        {
            await Email.SendContactFormMessageAsync(contactModel.Name, contactModel.Email, contactModel.Message);
            contactSent = true;
            contactModel = new(); // Reset form
        }
        finally
        {
            isSendingContact = false;
        }
    }

    List<Experience>? experiences;
    List<Skill>? skills;
    List<ProjectViewModel> projectViewModels = [];
    SiteProfile? profile;


    GitHubProfile? ghProfile;
    List<GitHubPinnedRepo>? pinnedRepos;
    List<GitHubPinnedRepo>? allRepos;
    List<GitHubContributionWeek>? ghContribWeeks;
    int ghContribTotal;
    int longestStreak;
    int currentStreak;
    List<(string Label, int Col)> monthLabels = [];
    string repoTab = "pinned";
    List<ConstellationSystem> constellations = [];
    string activeSystem = "";
    string _lastRenderedSystem = "";

    void SetSystem(string name) { activeSystem = name; }

    record ConstellationNode(string Name, double X, double Y, int Size, int Index, string LabelDir);
    record ConstellationEdge(int A, int B, double Weight);
    record ConstellationSystem(string Name, string Color, List<ConstellationNode> Nodes, List<ConstellationEdge> Edges);

    record ProjectViewModel(int Id, string Title, string Description, string TechStack, string? LiveUrl, string? RepoUrl, string IconName);

    protected override async Task OnInitializedAsync()
    {
        var profileTask     = Cache.GetAsync<SiteProfile>(CacheService.Keys.Profile);
        var experiencesTask = Cache.GetAsync<List<Experience>>(CacheService.Keys.Experiences);
        var skillsTask      = Cache.GetAsync<List<Skill>>(CacheService.Keys.Skills);
        var projectsTask    = Cache.GetAsync<List<Project>>(CacheService.Keys.Projects);
        await Task.WhenAll(profileTask, experiencesTask, skillsTask, projectsTask);

        profile               = profileTask.Result     ?? await FetchAndCache(Svc.GetProfileAsync(),                      CacheService.Keys.Profile);
        experiences           = experiencesTask.Result ?? await FetchAndCache(Svc.GetExperiencesAsync(),                  CacheService.Keys.Experiences);
        skills                = skillsTask.Result      ?? await FetchAndCache(Svc.GetSkillsAsync(),                       CacheService.Keys.Skills);
        var projects           = projectsTask.Result    ?? await FetchAndCache(Svc.GetProjectsAsync(),                     CacheService.Keys.Projects);

        if (projects is not null)
        {
            projectViewModels = projects.Select(p => new ProjectViewModel(
                p.Id, p.Title, p.Description, p.TechStack, p.LiveUrl, p.RepoUrl, DetermineIconName(p)
            )).ToList();
        }

        BuildConstellation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (constellations.Count > 0 && (firstRender || activeSystem != _lastRenderedSystem))
        {
            _lastRenderedSystem = activeSystem;
            await JS.InvokeVoidAsync("drawStarMap");
        }

        if (!firstRender) return;

        if (!string.IsNullOrWhiteSpace(profile?.GitHubUsername))
        {
            var username = profile.GitHubUsername;

            // Check cache for all GitHub data at once
            var ghProfileTask  = Cache.GetAsync<GitHubProfile>(CacheService.Keys.GitHubProfile);
            var pinnedTask     = Cache.GetAsync<List<GitHubPinnedRepo>>(CacheService.Keys.GitHubPinned);
            var contribTask    = Cache.GetAsync<List<GitHubContributionWeek>>(CacheService.Keys.GitHubContributions);
            var contribTotTask = Cache.GetAsync<int>(CacheService.Keys.GitHubContribTotal);

            await Task.WhenAll(ghProfileTask, pinnedTask, contribTask, contribTotTask);

            ghProfile      = ghProfileTask.Result;
            pinnedRepos    = pinnedTask.Result;
            ghContribWeeks = contribTask.Result;
            ghContribTotal = contribTotTask.Result;

            bool anyCached = ghProfile is not null || pinnedRepos is not null;

            if (anyCached)
            {
                // We have cached data — render immediately, then fill gaps in background
                pinnedRepos ??= [];
                StateHasChanged();
                _ = FetchMissingGitHubDataAsync(username, ghProfile is null, pinnedRepos.Count == 0, ghContribWeeks is null);
            }
            else
            {
                // Nothing cached — fetch profile + pinned in parallel (most important for display)
                var (fetchedProfile, fetchedPinned) = await FetchGitHubCoreAsync(username);
                ghProfile   = fetchedProfile;
                pinnedRepos = fetchedPinned ?? [];
                StateHasChanged();

                // Fetch all repos + contributions in background after first paint
                _ = FetchMissingGitHubDataAsync(username, false, false, true);
            }
        }
        else
        {
            pinnedRepos = [];
            allRepos    = [];
        }
    }

    async Task<(GitHubProfile?, List<GitHubPinnedRepo>?)> FetchGitHubCoreAsync(string username)
    {
        var profileTask = GitHub.GetProfileAsync(username);
        var pinnedTask  = GitHub.GetPinnedReposAsync(username);
        await Task.WhenAll(profileTask, pinnedTask);

        var p = await profileTask;
        var r = await pinnedTask;
        if (p is not null) await Cache.SetAsync(CacheService.Keys.GitHubProfile, p);
        if (r is not null) await Cache.SetAsync(CacheService.Keys.GitHubPinned, r);
        return (p, r);
    }

    async Task FetchMissingGitHubDataAsync(string username, bool needProfile, bool needPinned, bool needContrib)
    {
        try
        {
            if (needProfile || needPinned)
            {
                var (p, r) = await FetchGitHubCoreAsync(username);
                if (needProfile && p is not null) { ghProfile = p; }
                if (needPinned  && r is not null) { pinnedRepos = r; }
                await InvokeAsync(StateHasChanged);
            }

            // All repos — lower priority, load after core data
            allRepos = await Cache.GetAsync<List<GitHubPinnedRepo>>(CacheService.Keys.GitHubAllRepos)
                       ?? await FetchAndCache(GitHub.GetAllPublicReposAsync(username), CacheService.Keys.GitHubAllRepos);
            allRepos ??= [];
            await InvokeAsync(StateHasChanged);

            if (needContrib)
            {
                var (weeks, total) = await GitHub.GetContributionsAsync(username);
                ghContribWeeks = weeks; ghContribTotal = total;
                await Cache.SetAsync(CacheService.Keys.GitHubContributions, weeks);
                await Cache.SetAsync(CacheService.Keys.GitHubContribTotal, total);
            }
            if (ghContribWeeks is { Count: > 0 }) { ComputeStreaks(); BuildMonthLabels(); }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) { /* silently degrade — GitHub section just won't show */ }
    }

    void SetTab(string tab) => repoTab = tab;

    void BuildConstellation()
    {
        var allSkills = (skills ?? []).ToList();
        if (allSkills.Count == 0) return;

        // Define systems — groups of related skill name keywords
        // Each system has a name, color, and keyword matchers
        var systemDefs = new List<(string Name, string Color, string[] Keywords)>
        {
            ("Web API",       "#00e5ff", new[]{"asp.net","web api","restful","swagger","http","endpoint","api","controller"}),
            ("Data & Math",   "#ffd166", new[]{"sql","linq","entity framework","orm","data","algorithm","mathematical","time series","forecasting","modeling","mining"}),
            ("C# Core",       "#a29bfe", new[]{"c#","async","await","multithreading","task","parallelism","file i/o","blazor","fundamentals"}),
            ("Frontend",      "#fd79a8", new[]{"javascript","html","css","blazor","frontend","ui","web"}),
            ("DevOps & Tools",  "#74b9ff", new[]{"git","version control","docker","ci","cd","devops","azure","cloud","deploy"}),
        };

        // Assign each skill to the best matching system
        var buckets = systemDefs.Select(s => (s.Name, s.Color, Items: new List<Skill>())).ToList();

        foreach (var skill in allSkills)
        {
            var lower = skill.Name.ToLowerInvariant();
            int bestIdx = -1; int bestScore = 0;
            for (int si = 0; si < systemDefs.Count; si++)
            {
                int score = systemDefs[si].Keywords.Count(kw => lower.Contains(kw));
                if (score > bestScore) { bestScore = score; bestIdx = si; }
            }
            // fallback: match by category name
            if (bestIdx < 0)
            {
                var catLower = skill.Category.ToLowerInvariant();
                for (int si = 0; si < systemDefs.Count; si++)
                {
                    if (systemDefs[si].Keywords.Any(kw => catLower.Contains(kw))) { bestIdx = si; break; }
                }
            }
            if (bestIdx < 0) bestIdx = 0; // default to first system
            buckets[bestIdx].Items.Add(skill);
        }

        // Remove empty systems
        buckets = buckets.Where(b => b.Items.Count > 0).ToList();
        if (buckets.Count == 0) return;

        int maxProf = allSkills.Max(s => s.Proficiency);

        constellations = buckets.Select(bucket =>
        {
            var items = bucket.Items;
            int n = items.Count;
            var nodes = new List<ConstellationNode>();

            // Lay out nodes in a circle with enough radius to avoid label overlap
            // More nodes = bigger radius
            double baseR = n <= 3 ? 22 : n <= 6 ? 28 : n <= 10 ? 33 : 38;
            double cx = 50, cy = 50;

            for (int i = 0; i < n; i++)
            {
                double angle = (2 * Math.PI * i / n) - Math.PI / 2;
                double x = Math.Round(cx + baseR * Math.Cos(angle), 1);
                double y = Math.Round(cy + baseR * Math.Sin(angle) * 0.75, 1); // slightly squished vertically
                int sz = (int)(8 + 14 * ((double)items[i].Proficiency / maxProf));

                // Label direction: push label away from center
                string dir = angle switch {
                    var a when Math.Cos(a) > 0.5  => "cn-label-right",
                    var a when Math.Cos(a) < -0.5 => "cn-label-left",
                    var a when Math.Sin(a) > 0     => "cn-label-below",
                    _                              => ""
                };

                nodes.Add(new ConstellationNode(items[i].Name, x, y, sz, i, dir));
            }

            // Connect every node to every other in the same system (full constellation)
            var edges = new List<ConstellationEdge>();
            for (int i = 0; i < n; i++)
                for (int j = i + 1; j < n; j++)
                    edges.Add(new ConstellationEdge(i, j, 0.7));

            return new ConstellationSystem(bucket.Name, bucket.Color, nodes, edges);
        }).ToList();

        if (!constellations.Any(c => c.Name == activeSystem))
            activeSystem = constellations[0].Name;
    }

    void ComputeStreaks() {
        var days = ghContribWeeks!.SelectMany(w => w.Days).OrderBy(d => d.Date).ToList();
        int run=0, lng=0, cur=0; var today = DateTime.UtcNow.Date;
        foreach (var d in days) { if (d.Count>0) run++; else run=0; if (run>lng) lng=run; }
        foreach (var d in days.AsEnumerable().Reverse()) {
            if (!DateTime.TryParse(d.Date, out var dt)) break;
            if (dt.Date > today) continue;
            if (d.Count > 0) cur++; else break;
        }
        longestStreak = lng; currentStreak = cur;
    }

    void BuildMonthLabels() {
        monthLabels = []; string? last = null; int col = 1;
        foreach (var week in ghContribWeeks!) {
            var first = week.Days.FirstOrDefault();
            if (first is not null && DateTime.TryParse(first.Date, out var dt)) {
                var m = dt.ToString("MMM");
                if (m != last) { monthLabels.Add((m, col)); last = m; }
            }
            col++;
        }
    }

    async Task<T> FetchAndCache<T>(Task<T> task, string key) {
        var d = await task; await Cache.SetAsync(key, d); return d;
    }



    static string GetInitials(string? name) {
        if (string.IsNullOrWhiteSpace(name)) return "YN";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}".ToUpper() : name[..Math.Min(2,name.Length)].ToUpper();
    }

    static string TimeAgo(DateTime dt) {
        var d = DateTime.UtcNow - dt;
        if (d.TotalDays < 1) return "today";
        if (d.TotalDays < 7) return $"{(int)d.TotalDays}d ago";
        if (d.TotalDays < 30) return $"{(int)(d.TotalDays/7)}w ago";
        if (d.TotalDays < 365) return $"{(int)(d.TotalDays/30)}mo ago";
        return $"{(int)(d.TotalDays/365)}y ago";
    }

    private string DetermineIconName(Project p)
    {
        var tech = (p.TechStack ?? "").ToLowerInvariant();
        var title = p.Title.ToLowerInvariant();

        if (tech.Contains("react") || tech.Contains("vue") || tech.Contains("frontend") || tech.Contains("javascript") || tech.Contains("typescript")) 
            return "code";
        
        if (tech.Contains("dotnet") || tech.Contains(".net") || tech.Contains("c#") || tech.Contains("api") || tech.Contains("backend") || tech.Contains("server")) 
            return "server";
        
        if (tech.Contains("sql") || tech.Contains("db") || tech.Contains("database") || tech.Contains("entity framework") || tech.Contains("ef core") || tech.Contains("postgresql")) 
            return "database";
        
        if (tech.Contains("cloud") || tech.Contains("azure") || tech.Contains("aws") || tech.Contains("docker") || tech.Contains("kubernetes") || tech.Contains("deploy")) 
            return "cloud";
        
        if (tech.Contains("mobile") || tech.Contains("android") || tech.Contains("ios") || tech.Contains("flutter")) 
            return "smartphone";
        
        if (tech.Contains("ai") || tech.Contains("machine learning") || tech.Contains("python") || tech.Contains("math")) 
            return "cpu";

        if (tech.Contains("terminal") || tech.Contains("cli") || tech.Contains("bash") || tech.Contains("shell")) 
            return "terminal";

        return "box";
    }
}
